# ============================================================================
# NeutriAI — environment. Copy to backend/.env and fill in.
# Never commit the filled version.
# ============================================================================

# ---- app ----
ENV=local                       # local | staging | production
LOG_LEVEL=INFO
API_PREFIX=/v1
CORS_ORIGINS=*
# ^ comma-separated list, or a JSON array. In production name real origins:
#   CORS_ORIGINS=https://neutriai.com,https://www.neutriai.com

# ---- Supabase ----------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...                 # safe to ship in the mobile app
SUPABASE_SERVICE_KEY=eyJ...              # SERVER ONLY. Bypasses RLS.
SUPABASE_JWT_SECRET=your-jwt-secret      # Settings -> API -> JWT Secret
SUPABASE_JWT_AUDIENCE=authenticated

# ---- AI ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
VISION_MODEL=gpt-4o                      # recognition + geometry
REASONING_MODEL=claude-sonnet-4-5        # sanity checks, advice, plans
COACH_MODEL=claude-sonnet-4-5
MOTIVATION_MODEL=claude-haiku-4-5        # short, high-volume, cheap
AI_DAILY_COST_CEILING_USD=50
AI_TIMEOUT_S=45

# ---- nutrition databases ----------------------------------------------
# USDA is free (fdc.nal.usda.gov/api-key-signup.html) and covers whole foods.
USDA_API_KEY=
# Nutritionix is best for restaurant + branded items.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
# Edamam is the general-purpose fallback.
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
NUTRITION_PROVIDER_ORDER=usda,nutritionix,edamam

# ---- Stripe ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...           # $6.99 / month recurring
STRIPE_PRICE_ANNUAL=price_...            # $50.00 / year recurring
STRIPE_TRIAL_DAYS=15
STRIPE_SUCCESS_URL=neutriai://billing/success
STRIPE_CANCEL_URL=neutriai://billing/cancel
STRIPE_PORTAL_RETURN_URL=neutriai://billing/return

# ---- wearables ---------------------------------------------------------
# Apple Health and Samsung Health need NO server credentials — the phone reads
# them locally and pushes to POST /v1/health/push.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://api.neutriai.com/v1/integrations/callback

# ---- infra -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Fernet key for encrypting provider OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
FREE_TIER_DAILY_SCANS=3
# A subscription is not a blank cheque. Pro used to be unmetered, which is a
# subscription-priced hole: one account, unlimited GPT-4o vision calls, at a
# per-scan cost the subscription does not cover. High enough that no real
# person meets it, low enough that a script does.
PRO_DAILY_SCAN_CEILING=200
# NeutriAI launches free for everyone while it collects real corrected usage
# data, with no way to actually collect payment set up yet -- on by default.
# Flip to false the day billing turns on for real; no other change needed.
FREE_LAUNCH_MODE=true
RATE_LIMIT_PER_MINUTE=120

# ---- in-app purchase (mobile only; Stripe still serves the web) --------
# Apple: App Store Connect -> Users and Access -> Integrations -> In-App Purchase
APPLE_BUNDLE_ID=app.neutriai.mobile
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# .p8 file contents on ONE line, real newlines replaced with \n
APPLE_PRIVATE_KEY=
# Google: Play Console -> Setup -> API access -> service account with
# "View financial data" + "Manage orders and subscriptions". Whole JSON, one line.
ANDROID_PACKAGE_NAME=app.neutriai.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT=

# ---- depth model (measures food height instead of assuming it) ---------
# Off by default. With nothing set here the app measures no heights and every
# portion uses its prior height table, which is exactly today's behaviour.
#
# LICENCE FIRST: use Depth Anything V2 **Small** (Apache-2.0). The Base, Large
# and Giant weights are CC-BY-NC and cannot legally serve a paid app.
#
# Two dialects. "replicate" talks to Replicate's predictions API; "http" posts
# the photo to any endpoint you host yourself and reads the map back.
DEPTH_PROVIDER=
DEPTH_API_KEY=
# REQUIRED whenever DEPTH_PROVIDER is set, and only "Small" is accepted -- leave it
# out and depth stays OFF. On "replicate" it is sent as model_size on every
# prediction; chenxwh/depth-anything-v2 otherwise DEFAULTS to "Large" (CC-BY-NC).
DEPTH_MODEL_SIZE=
# "replicate": the model version id (the long hex string on the model's page)
DEPTH_MODEL_VERSION=
# "http": the full URL to POST the photo to
DEPTH_ENDPOINT=
# Whatever the model calls its image input, and any extra JSON input it needs.
# Do not put a model size here; a conflicting one switches depth off.
DEPTH_IMAGE_FIELD=image
DEPTH_MODEL_INPUT=
# The key holding the depth map when the model answers with several outputs.
# chenxwh/depth-anything-v2 returns {"grey_depth", "color_depth"}: set grey_depth.
# The colour one is refused, and leaving this empty drops the answer unread.
DEPTH_OUTPUT_FIELD=
DEPTH_TIMEOUT_S=25

# Is there a load balancer in front of the API? Decides whether the rate
# limiter believes `x-forwarded-for`. Leave false unless something in front is
# guaranteed to overwrite that header -- a header the caller can set is a
# rate-limit key the caller can rotate.
TRUST_PROXY_HEADER=false

# ---- segmenter: SAM2 (which pixels are which food, and where the plate is) ----
# Off by default. Unconfigured, the split comes from the model's own area claim,
# on a 0.05 grid where one step is 45% of the food's weight.
#
# Two jobs: a mask per food for the split, and the PLATE OUTLINE, which is the
# one blocking the depth scale and the measured footprint. Six hand-rolled
# methods have failed at the second.
SEGMENTER_PROVIDER=
# Which SHAPE of model this is. Run `dev segcheck` -- it asks the model
# and tells you. meta/sam-2 is "auto": it takes no point coordinates,
# returns every mask it finds, and one call covers the whole photograph.
SEGMENTER_MODE=prompted
SEGMENTER_API_KEY=
SEGMENTER_MODEL_VERSION=
SEGMENTER_ENDPOINT=
# What the model calls its inputs, and anything extra it needs.
SEGMENTER_IMAGE_FIELD=image
SEGMENTER_POINTS_FIELD=point_coords
SEGMENTER_MODEL_INPUT=
SEGMENTER_OUTPUT_FIELD=
SEGMENTER_TIMEOUT_S=30
