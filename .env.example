# ============================================================================
# NeutriAI — environment. Copy to backend/.env and fill in.
# Never commit the filled version.
# ============================================================================

# ---- app ----
ENV=local                       # local | staging | production
LOG_LEVEL=INFO
API_PREFIX=/v1
CORS_ORIGINS=*
# ^ comma-separated list, or a JSON array. In production name real origins:
#   CORS_ORIGINS=https://neutriai.app,https://www.neutriai.app

# ---- Supabase ----------------------------------------------------------
# Dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...                 # safe to ship in the mobile app
SUPABASE_SERVICE_KEY=eyJ...              # SERVER ONLY. Bypasses RLS.
SUPABASE_JWT_SECRET=your-jwt-secret      # Settings -> API -> JWT Secret
SUPABASE_JWT_AUDIENCE=authenticated

# ---- AI ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
VISION_MODEL=gpt-4o                      # recognition + geometry
REASONING_MODEL=claude-sonnet-4-5        # sanity checks, advice, plans
COACH_MODEL=claude-sonnet-4-5
MOTIVATION_MODEL=claude-haiku-4-5        # short, high-volume, cheap
AI_DAILY_COST_CEILING_USD=50
AI_TIMEOUT_S=45

# ---- nutrition databases ----------------------------------------------
# USDA is free (fdc.nal.usda.gov/api-key-signup.html) and covers whole foods.
USDA_API_KEY=
# Nutritionix is best for restaurant + branded items.
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
# Edamam is the general-purpose fallback.
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
NUTRITION_PROVIDER_ORDER=usda,nutritionix,edamam

# ---- Stripe ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...           # $6.99 / month recurring
STRIPE_PRICE_ANNUAL=price_...            # $50.00 / year recurring
STRIPE_TRIAL_DAYS=15
STRIPE_SUCCESS_URL=neutriai://billing/success
STRIPE_CANCEL_URL=neutriai://billing/cancel
STRIPE_PORTAL_RETURN_URL=neutriai://billing/return

# ---- wearables ---------------------------------------------------------
# Apple Health and Samsung Health need NO server credentials — the phone reads
# them locally and pushes to POST /v1/health/push.
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
GARMIN_CONSUMER_KEY=
GARMIN_CONSUMER_SECRET=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=https://api.neutriai.app/v1/integrations/callback

# ---- infra -------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Fernet key for encrypting provider OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
FREE_TIER_DAILY_SCANS=3
RATE_LIMIT_PER_MINUTE=120

# ---- in-app purchase (mobile only; Stripe still serves the web) --------
# Apple: App Store Connect -> Users and Access -> Integrations -> In-App Purchase
APPLE_BUNDLE_ID=app.neutriai.mobile
APPLE_KEY_ID=
APPLE_ISSUER_ID=
# .p8 file contents on ONE line, real newlines replaced with \n
APPLE_PRIVATE_KEY=
# Google: Play Console -> Setup -> API access -> service account with
# "View financial data" + "Manage orders and subscriptions". Whole JSON, one line.
ANDROID_PACKAGE_NAME=app.neutriai.mobile
GOOGLE_PLAY_SERVICE_ACCOUNT=
