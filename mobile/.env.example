# NeutriAI mobile — copy to mobile/.env and fill in.
# Expo loads this automatically. EXPO_PUBLIC_ values are embedded in the app
# bundle, so ONLY put publishable values here. Never the Supabase service key.

# Supabase project settings -> API. Same two values as SUPABASE_URL and
# SUPABASE_ANON_KEY in backend/.env.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The backend, including the /v1 prefix.
#   Local dev on a physical phone: use your computer's LAN IP, not localhost —
#   localhost on the phone is the phone.  e.g. http://192.168.1.42:8000/v1
#   Android emulator: http://10.0.2.2:8000/v1
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/v1

# Optional. Only needed if you add native Stripe payment sheets later; the
# current paywall uses hosted Checkout in a browser and does not need it.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
